{
  "name": "@nativectx/ui",
  "version": "0.2.0",
  "description": "React Native UI components optimized for LLMs — one design system for iOS, Android, and web, with an MCP server and Claude Skills.",
  "license": "MIT",
  "author": "Alex Amayo",
  "repository": {
    "type": "git",
    "url": "https://github.com/nativectx/ui.git"
  },
  "homepage": "https://nativectx.com",
  "keywords": [
    "react-native",
    "expo",
    "ui-components",
    "design-system",
    "cross-platform",
    "ios",
    "android",
    "web",
    "theming",
    "components",
    "mcp",
    "claude",
    "claude-skills",
    "llm",
    "ai"
  ],
  "bin": {
    "nativectx": "./dist/mcp/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/mcp/cli.mjs",
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "default": "./dist/brand/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    },
    "./context": {
      "types": "./dist/context/scroll-context.d.ts",
      "default": "./dist/context/scroll-context.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./components/*/*": {
      "types": "./dist/components/*/*.d.ts",
      "default": "./dist/components/*/*.js"
    },
    "./ui": {
      "types": "./dist/components/ui/index.d.ts",
      "default": "./dist/components/ui/index.js"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && pnpm exec tsc -p tsconfig.build.json && pnpm run build:mcp",
    "build:manifest": "tsx mcp/build-manifest.ts",
    "check:skills": "tsx mcp/check-skills-sync.ts",
    "check:examples": "tsx mcp/check-examples.ts",
    "build:mcp": "tsx mcp/build-manifest.ts && esbuild mcp/cli.ts --bundle --platform=node --format=esm --outfile=dist/mcp/cli.mjs --banner:js='#!/usr/bin/env node' && rm -rf dist/mcp/skills && cp -r ../.claude/skills dist/mcp/skills",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepack": "cp ../README.md ./README.md && cp ../LICENSE ./LICENSE",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0"
  },
  "peerDependencies": {
    "@expo/ui": "*",
    "@expo/vector-icons": "*",
    "@react-native-community/slider": "*",
    "expo-image": "*",
    "expo-router": "*",
    "expo-symbols": "*",
    "react": ">=18.0.0",
    "react-native": ">=0.70.0",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "sf-symbols-typescript": "*"
  },
  "peerDependenciesMeta": {
    "@expo/ui": {
      "optional": false
    },
    "@expo/vector-icons": {
      "optional": true
    },
    "@react-native-community/slider": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    },
    "expo-symbols": {
      "optional": true
    },
    "sf-symbols-typescript": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": false
    },
    "react-native-safe-area-context": {
      "optional": false
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "expo-router": "~56.2.18",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "19.2.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3"
  }
}
