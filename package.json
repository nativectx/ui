{
  "name": "nativectx-monorepo",
  "version": "1.0.1",
  "private": true,
  "workspaces": [
    "ui",
    "nativectx",
    "apps/*"
  ],
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "prepare": "husky",
    "dev": "pnpm build && pnpm --filter demo web",
    "dev:ios": "pnpm build && pnpm --filter demo ios",
    "dev:android": "pnpm build && pnpm --filter demo android",
    "dev:storybook": "pnpm build && pnpm --filter @nativectx/storybook storybook:web",
    "dev:storybook:native": "pnpm build && pnpm --filter @nativectx/storybook storybook",
    "build": "pnpm --filter @nativectx/ui run build",
    "build:watch": "pnpm --filter @nativectx/ui exec tsc -p tsconfig.build.json --watch",
    "export:web": "pnpm build && pnpm --filter demo export:web",
    "deploy:web": "pnpm run export:web && pnpm --filter demo run deploy:web",
    "deploy:web:preview": "pnpm run export:web && pnpm --filter demo run deploy:web:preview",
    "release": "pnpm build && pnpm --filter @nativectx/ui publish --access public --no-git-checks",
    "release:cli": "pnpm --filter nativectx publish --access public --no-git-checks",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm --filter @nativectx/ui test",
    "lint": "pnpm --filter demo lint",
    "lint:fix": "pnpm --filter demo lint -- --fix",
    "check": "pnpm run check:manifest && pnpm run check:skills && pnpm run check:examples",
    "check:manifest": "pnpm --filter @nativectx/ui run build:manifest",
    "check:skills": "pnpm --filter @nativectx/ui run check:skills",
    "check:examples": "pnpm --filter @nativectx/ui run check:examples",
    "clean": "rm -rf ui/dist apps/*/dist apps/*/.expo"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "react-docgen-typescript": "2.2.2",
      "@types/react": "19.2.14",
      "react": "19.2.3",
      "react-native": "0.85.3",
      "react-native-reanimated": "4.3.1",
      "react-native-safe-area-context": "5.7.0"
    },
    "patchedDependencies": {
      "@expo/dom-webview@0.2.8": "patches/@expo__dom-webview@0.2.8.patch"
    }
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "apps/demo/**/*.{ts,tsx}": [
      "eslint --fix --config apps/demo/eslint.config.js"
    ],
    "*.{ts,tsx}": [
      "bash -c 'pnpm typecheck'"
    ],
    ".claude/skills/*.md": [
      "bash -c 'pnpm check:manifest && pnpm check:skills'"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.13",
    "expo": "~56.0.8",
    "react": "19.2.3",
    "react-native": "0.85.3"
  }
}
